{
  "installCommand": "cd ../.. && NODE_ENV=development pnpm install --frozen-lockfile",
  "buildCommand": "cd ../.. && pnpm --filter @melli/admin build",
  "outputDirectory": ".next",
  "framework": "nextjs",
  "crons": [
    { "path": "/api/cron/competitor", "schedule": "*/5 * * * *" },
    { "path": "/api/cron/prices",     "schedule": "*/15 * * * *" },
    { "path": "/api/cron/gold",       "schedule": "* * * * *" }
  ]
}
